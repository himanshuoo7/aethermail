MAIL_ACCOUNT_ID=real-imap
MAIL_ACCOUNT_NAME=Personal IMAP
MAIL_ACCOUNT_EMAIL=your-test-email@example.com
MAIL_ACCOUNT_PROVIDER=imap

IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=your-test-email@example.com
IMAP_PASS=your-app-password
IMAP_MAILBOX=INBOX
IMAP_ARCHIVE_MAILBOX=Archive
IMAP_TRASH_MAILBOX=Trash

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-test-email@example.com
SMTP_PASS=your-app-password

SERVER_PORT=8787

# Google OAuth — enables "Sign in with Google" for Gmail accounts
# Setup: console.cloud.google.com → New project → APIs & Services → Credentials → OAuth 2.0 Client ID
# Application type: Web application, Redirect URI: http://localhost:8787/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth — enables "Sign in with Microsoft" for Office 365 accounts
# Setup: portal.azure.com → App registrations → New registration
# Redirect URI: http://localhost:8787/api/auth/microsoft/callback, Supported account types: Multitenant
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional real AI. Keep this server-side only.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-new-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=sk-your-new-key-here
OPENAI_MODEL=gpt-4.1-mini
